# Auto-Repro Environment Configuration
VPS_PUBLIC_IP=127.0.0.1
PROVISIONER_TOKEN=autorepro_secret_token_123
PROVISIONER_URL=http://provisioner:4000

# GitHub Integration
GITHUB_TOKEN=            # Personal Access Token (PAT) with issues:write scope
GITHUB_WEBHOOK_SECRET=auto_repro_webhook_secret_xyz

# GitHub target repo for verified issues (Jira front door -> GitHub issue)
GITHUB_REPO_OWNER=yourusername
GITHUB_REPO_NAME=taskboard

# Jira Integration (Jira Cloud)
JIRA_DOMAIN=yourcompany.atlassian.net
JIRA_EMAIL=your.email@domain.com
JIRA_API_TOKEN=your_atlassian_api_token
# Jira workflow transition IDs are project specific. Find them via:
#   GET https://<JIRA_DOMAIN>/rest/api/2/issue/<KEY>/transitions
JIRA_TRANSITION_SENT_TO_ENG=21
JIRA_TRANSITION_CANNOT_REPRODUCE=31

# LLM & Agent Config
LLM_API_KEY=
TINYFISH_API_KEY=sk-tinyfish-QNksJksqS4EWRb0SN3Zoim3dr1g3fe_H
TINYFISH_MOCK=false       # set to false when real TinyFish API is wired up

# n8n Configuration
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=password123
