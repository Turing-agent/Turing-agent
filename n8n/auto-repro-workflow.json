    {
      "parameters": {
        "jsCode": "// Route decision: only a REPRODUCED verdict reaches GitHub.\nconst gate = $('LLM Gatekeeper (Fallback)').first().json;\nconst tf = $('TinyFish Agent').first().json || {};\n\nlet verdict = 'NOT_REPRODUCED';\nif (!tf || tf.completed === false) {\n  verdict = 'INCONCLUSIVE';\n} else {\n  const hasNet = Array.isArray(tf.network_errors) && tf.network_errors.some(e => e.status >= 400);\n  const hasCon = Array.isArray(tf.console_errors) && tf.console_errors.length > 0;\n  const hasVis = Array.isArray(tf.visible_errors) && tf.visible_errors.length > 0;\n  if (hasNet || hasCon || hasVis) verdict = 'REPRODUCED';\n}\n\nreturn [{\n  json: {\n    ...gate,\n    verdict,\n    shouldCreateGithubIssue: verdict === 'REPRODUCED',\n    observations: tf\n  }\n}];"
      },
