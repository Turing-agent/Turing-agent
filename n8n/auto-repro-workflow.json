    {
      "parameters": {
        "jsCode": "// Branch: does this Jira issue carry attachments to migrate?\nconst item = $('Parse Jira Issue').first().json;\nreturn [{\n  json: {\n    ...item,\n    hasAttachments: item.attachmentCount > 0\n  }\n}];"
      },
