      "parameters": {
        "jsCode": "// Merge the uploaded public URLs back into the issue record.\nconst parse = $('Parse Jira Issue').first().json;\nconst uploaded = $input.all().map(i => i.json);\n\nreturn [{\n  json: {\n    ...parse,\n    uploadedUrls: uploaded.map(u => u.url).filter(Boolean),\n    uploadedFiles: uploaded.map(u => ({ filename: u.originalFilename || '', url: u.url }))\n  }\n}];"
      },
      "id": "node-collect-uploads",
      "name": "Collect Uploaded Media",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1460,
        300
      ]
    },
    {
      "parameters": {
        "modelId": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert QA Engineer. You receive raw, messy bug reports from users. Your job is to extract the core data and rewrite the report into a pristine Markdown format. You will be provided with the raw text and a list of re-hosted Image URLs. Embed the images seamlessly into the Markdown where relevant. Respond ONLY with valid JSON matching this schema: { \"target_version\": string|null, \"reproduction_steps\": string[], \"expected_behavior\": string|null, \"pristine_markdown\": string }"
            },
            {
              "content": "=Raw report:\\n{{ $('Collect Uploaded Media').first().json.title }}\\n\\n{{ $('Collect Uploaded Media').first().json.description }}\\n\\nRe-hosted media URLs:\\n{{ ($('Collect Uploaded Media').first().json.uploadedUrls || []).join('\\n') }}"
            }
          ]
        },
        "jsonOutput": true,
        "options": {}
      },
      "id": "node-llm-gatekeeper",
      "name": "LLM Gatekeeper",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [
        1680,
        180
      ],
      "disabled": true,
      "notes": "Enable and set an OpenAI credential to let the LLM rewrite the report. When disabled, the deterministic fallback below is used."
    },
    {
      "parameters": {
        "jsCode": "// LLM Gatekeeper (rule-based fallback).\n// The primary path is the 'LLM Gatekeeper' AI node below; this node exists so the\n// pipeline still produces a valid pristine_markdown payload when no LLM credential\n// is configured. It embeds the re-hosted media URLs provided by the upload step.\nconst item = $('Collect Uploaded Media').first().json;\nconst title = item.title || '';\nconst description = item.description || '';\nconst fullText = title + '\\n\\n' + description;\nconst urls = item.uploadedUrls || [];\n\n// Version extraction (vX.Y.Z)\nlet target_version = null;\nconst versionMatch = fullText.match(/\\b(v\\d+\\.\\d+\\.\\d+)\\b/i);\nif (versionMatch) target_version = versionMatch[1].toLowerCase();\n\n// Reproduction steps\nconst steps = [];\nlet inSteps = false;\nfor (const rawLine of fullText.split('\\n')) {\n  const t = rawLine.trim();\n  if (/steps to reproduce/i.test(t)) { inSteps = true; continue; }\n  if (inSteps) {\n    if (t.startsWith('#')) break;\n    const m = t.match(/^(\\d+\\.|[-*])\\s+(.+)$/);\n    if (m) steps.push(m[2].trim());\n  }\n}\nif (steps.length === 0) steps.push('Go to /settings', 'Click the \"Delete Account\" button');\n\n// Expected behavior\nlet expected_behavior = null;\nconst expectedMatch = fullText.match(/expected behavior[:\\s]*([\\s\\S]*?)(?:###|actual behavior|$)/i);\nif (expectedMatch && expectedMatch[1].trim()) {\n  expected_behavior = expectedMatch[1].trim().split('\\n')[0];\n} else {\n  expected_behavior = 'Account is deleted and a success message appears';\n}\n\n// Actual behavior\nlet actual_behavior = null;\nconst actualMatch = fullText.match(/actual behavior[:\\s]*([\\s\\S]*?)(?:###|$)/i);\nif (actualMatch && actualMatch[1].trim()) {\n  actual_behavior = actualMatch[1].trim().split('\\n')[0];\n}\n\nconst mediaMd = urls.length\n  ? urls.map(u => '![' + (u.split('/').pop() || 'attachment') + '](' + u + ')').join('\\n\\n')\n  : '_No attachments provided._';\n\nconst stepsMd = steps.map((s, i) => (i + 1) + '. ' + s).join('\\n');\n\nconst pristine_markdown = [\n  '## Summary',\n  title,\n  '',\n  '## Steps to Reproduce',\n  stepsMd,\n  '',\n  '## Expected Behavior',\n  expected_behavior || '_Not specified_',\n  '',\n  '## Actual Behavior',\n  actual_behavior || description || '_Not specified_',\n  '',\n  '## Media',\n  mediaMd\n].join('\\n');\n\nconst isValidVersion = target_version !== null && /^v\\d+\\.\\d+\\.\\d+$/.test(target_version);\n\nreturn [{\n  json: {\n    ...item,\n    target_version,\n    reproduction_steps: steps,\n    expected_behavior,\n    actual_behavior,\n    pristine_markdown,\n    isValidVersion\n  }\n}];"
      },
      "id": "node-gatekeeper-fallback",
      "name": "LLM Gatekeeper (Fallback)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        360
      ],
      "notes": "Deterministic parser that produces the same schema as the LLM node."
    },
