    {
      "parameters": {
        "jsCode": "// Build the TinyFish proof comment (structured evidence).\nconst gate = $('LLM Gatekeeper (Fallback)').first().json;\nconst tf = $('TinyFish Agent').first().json || {};\nconst verdict = gate.verdict || 'INCONCLUSIVE';\n\nconst net = (tf.network_errors || []).map(e => '- Network: `' + e.method + ' ' + e.url + '` -> **' + e.status + '**').join('\\n');\nconst con = (tf.console_errors || []).map(c => '- Console: `' + c + '`').join('\\n');\nconst vis = (tf.visible_errors || []).map(v => '- Visible: `' + v + '`').join('\\n');\nconst evidence = [net, con, vis].filter(Boolean).join('\\n') || '_No errors captured._';\nconst shot = tf.screenshot_url ? '\\n\\n![screenshot](' + tf.screenshot_url + ')' : '';\n\nconst body = [\n  '### Agent Verification Evidence (' + verdict + ')',\n  '**Version tested:** `' + (gate.target_version || 'unknown') + '` (fresh disposable container)',\n  '**Final UI state:** ' + (tf.final_ui_state || 'n/a'),\n  '',\n  '**Evidence:**',\n  evidence + shot,\n  '',\n  '_Generated automatically by Auto-Repro (TinyFish agent). The test environment was destroyed after verification._'\n].join('\\n');\n\nreturn [{ json: { ...gate, tinyfishComment: body } }];"
      },
