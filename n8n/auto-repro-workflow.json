      "id": "node-jira-webhook",
      "name": "Jira Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        140,
        300
      ],
      "webhookId": "jira-issues"
    },
    {
      "parameters": {
        "jsCode": "// Parse the Jira webhook payload (issued created / updated).\nconst body = $input.first().json.body || $input.first().json;\nconst issue = body.issue || {};\nconst fields = issue.fields || {};\n\nconst attachments = Array.isArray(fields.attachment) ? fields.attachment : [];\nconst labels = Array.isArray(fields.labels) ? fields.labels : [];\n\nconst desc = fields.description || '';\n// Jira Cloud v3 descriptions are ADF documents; v2 (webhooks) are plain strings.\nlet descriptionText = '';\nif (typeof desc === 'string') {\n  descriptionText = desc;\n} else if (desc && typeof desc === 'object') {\n  const walk = (node, out) => {\n    if (!node) return;\n    if (typeof node === 'string') { out.push(node); return; }\n    if (Array.isArray(node)) { node.forEach(n => walk(n, out)); return; }\n    if (node.text) out.push(node.text);\n    if (node.type === 'hardBreak') out.push('\\n');\n    if (node.content) walk(node.content, out);\n  };\n  const out = [];\n  walk(desc, out);\n  descriptionText = out.join(' ');\n}\n\nreturn [{\n  json: {\n    event: body.webhookEvent || '',\n    issueKey: issue.key || '',\n    issueId: issue.id || '',\n    title: fields.summary || '',\n    description: descriptionText,\n    labels,\n    attachmentCount: attachments.length,\n    attachments: attachments.map(a => ({\n      id: a.id,\n      filename: a.filename || 'attachment',\n      mimeType: a.mimeType || 'application/octet-stream',\n      size: a.size || 0,\n      content: a.content || ''\n    })),\n    hasAttachments: attachments.length > 0,\n    // Attachments in this order: first attachment, then the rest (or a single empty item)\n    firstAttachment: attachments.length > 0\n      ? { id: attachments[0].id, filename: attachments[0].filename, mimeType: attachments[0].mimeType, content: attachments[0].content }\n      : null,\n    restAttachments: attachments.slice(1).map(a => ({\n      id: a.id, filename: a.filename, mimeType: a.mimeType, content: a.content\n    }))\n  }\n}];"
      },
      "id": "node-parse-jira",
      "name": "Parse Jira Issue",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        300
      ]
    },
