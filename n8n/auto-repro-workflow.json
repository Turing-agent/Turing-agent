    {
      "parameters": {
        "jsCode": "// Build the Basic Auth header used to download protected Jira attachments.\nconst email = $env.JIRA_EMAIL || '';\nconst token = $env.JIRA_API_TOKEN || '';\nconst basic = Buffer.from(email + ':' + token).toString('base64');\n\n// Attachments to migrate: first one comes from the IF-branch item, the rest from Parse.\nconst parse = $('Parse Jira Issue').first().json;\nconst queue = [];\nif (parse.firstAttachment) queue.push(parse.firstAttachment);\nfor (const a of (parse.restAttachments || [])) queue.push(a);\n\nreturn queue.map(a => ({\n  json: {\n    attachmentId: a.id,\n    filename: a.filename,\n    mimeType: a.mimeType,\n    contentUrl: a.content,\n    authHeader: 'Basic ' + basic\n  }\n}));"
      },
