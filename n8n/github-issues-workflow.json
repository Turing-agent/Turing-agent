{
  "name": "Auto-Repro Pipeline (GitHub Issues)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "github-issues",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "node-webhook",
      "name": "GitHub Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        300
      ],
      "webhookId": "github-issues"
    },
    {
      "parameters": {
        "jsCode": "// Verify GitHub action and extract payload\nconst payload = $input.first().json.body || $input.first().json;\nconst headers = $input.first().json.headers || {};\n\nconst action = payload.action;\nconst issue = payload.issue || {};\nconst repository = payload.repository || {};\n\nconst isOpened = action === \"opened\";\n\nreturn [{\n  json: {\n    isOpened,\n    action,\n    issueNumber: issue.number || 0,\n    title: issue.title || \"\",\n    body: issue.body || \"\",\n    repoOwner: repository.owner ? (repository.owner.login || repository.owner.name) : \"\",\n    repoName: repository.name || \"\",\n    sender: (payload.sender && payload.sender.login) || \"anonymous\"\n  }\n}];"
      },
      "id": "node-parse-webhook",
      "name": "Parse Webhook",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.isOpened }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-if-opened",
      "name": "If Action Opened",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        580,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PROVISIONER_URL || \"http://provisioner:4000\" }}/events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Auth-Token",
              "value": "={{ $env.PROVISIONER_TOKEN || \"autorepro_secret_token_123\" }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "run_id",
              "value": "={{ \"issue_\" + $json.issueNumber }}"
            },
            {
              "name": "stage",
              "value": "ISSUE_RECEIVED"
            },
            {
              "name": "message",
              "value": "={{ \"Received issue #\" + $json.issueNumber + \": \" + $json.title }}"
            },
            {
              "name": "data",
              "value": "={{ { issueNumber: $json.issueNumber, title: $json.title } }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-emit-received",
      "name": "Emit ISSUE_RECEIVED",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extract target version and steps\nconst item = $(\"Parse Webhook\").first().json;\nconst title = item.title || \"\";\nconst body = item.body || \"\";\nconst fullText = title + \"\\n\\n\" + body;\n\nlet target_version = null;\nconst versionMatch = fullText.match(/\\b(v\\d+\\.\\d+\\.\\d+)\\b/i) || fullText.match(/version[:\\s]+([0-9]+\\.[0-9]+\\.[0-9]+)/i);\nif (versionMatch) {\n  let v = versionMatch[1];\n  if (!v.startsWith(\"v\") && !v.startsWith(\"V\")) {\n    v = \"v\" + v;\n  }\n  target_version = v.toLowerCase();\n}\n\nconst reproduction_steps = [];\nconst stepLines = fullText.split(\"\\n\");\nlet inSteps = false;\nfor (const line of stepLines) {\n  const trimmed = line.trim();\n  if (/steps to reproduce/i.test(trimmed)) {\n    inSteps = true;\n    continue;\n  }\n  if (inSteps) {\n    if (trimmed.startsWith(\"#\")) break;\n    const match = trimmed.match(/^(\\d+\\.|[-*])\\s+(.+)$/);\n    if (match) reproduction_steps.push(match[2].trim());\n  }\n}\nif (reproduction_steps.length === 0) {\n  reproduction_steps.push(\"Go to /settings\", \"Click the Delete Account button\");\n}\n\nlet expected_behavior = \"Account is deleted and a success message appears\";\nconst expectedMatch = fullText.match(/expected behavior[:\\s]*([\\s\\S]*?)(?:###|actual behavior|$)/i);\nif (expectedMatch && expectedMatch[1].trim()) {\n  expected_behavior = expectedMatch[1].trim().split(\"\\n\")[0];\n}\n\nconst isValidVersion = target_version !== null && /^v\\d+\\.\\d+\\.\\d+$/.test(target_version);\n\nreturn [{\n  json: {\n    ...item,\n    target_version,\n    reproduction_steps,\n    expected_behavior,\n    isValidVersion\n  }\n}];"
      },
      "id": "node-extract-details",
      "name": "Extract Details (LLM / Parser)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
