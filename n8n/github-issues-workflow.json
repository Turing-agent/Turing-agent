              "value": "={{ $(\"Extract Details (LLM / Parser)\").first().json.reproduction_steps }}"
            },
            {
              "name": "expected_behavior",
              "value": "={{ $(\"Extract Details (LLM / Parser)\").first().json.expected_behavior }}"
            },
            {
              "name": "version",
              "value": "={{ $(\"Extract Details (LLM / Parser)\").first().json.target_version }}"
            },
            {
              "name": "run_id",
              "value": "={{ $json.run_id }}"
            }
          ]
        },
        "options": {
          "continueOnFail": true,
          "timeout": 120000
        }
      },
      "id": "node-tinyfish",
      "name": "TinyFish Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1580,
        100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Section 5.2 Verdict Logic\nconst tinyfish = $input.first().json;\nconst extractData = $(\"Extract Details (LLM / Parser)\").first().json;\nconst provData = $(\"Provision Container\").first().json;\n\nconst version = extractData.target_version || \"unknown\";\nconst steps = extractData.reproduction_steps || [];\nconst run_id = provData.run_id;\n\nlet verdict = \"NOT_REPRODUCED\";\n\nif (!tinyfish || tinyfish.completed === false) {\n  verdict = \"INCONCLUSIVE\";\n} else {\n  const hasNetworkError = Array.isArray(tinyfish.network_errors) && tinyfish.network_errors.some(e => e.status >= 400);\n  const hasConsoleError = Array.isArray(tinyfish.console_errors) && tinyfish.console_errors.length > 0;\n  const hasVisibleError = Array.isArray(tinyfish.visible_errors) && tinyfish.visible_errors.length > 0;\n\n  if (hasNetworkError || hasConsoleError || hasVisibleError) {\n    verdict = \"REPRODUCED\";\n  } else {\n    verdict = \"NOT_REPRODUCED\";\n  }\n}\n\nlet markdown = \"\";\nconst screenshotUrl = tinyfish.screenshot_url || \"\";\nconst screenshotMd = screenshotUrl ? \"\\\\n![screenshot](\" + screenshotUrl + \")\" : \"\";\n\nif (verdict === \"REPRODUCED\") {\n  const stepsMd = steps.map((s, i) => (i + 1) + \". \" + s).join(\"\\\\n\");\n  markdown = \"### ✅ Agent Verified: Bug reproduced\\\\n**Version tested:** `\" + version + \"` (fresh disposable container)\\\\n**Observed:** \" + tinyfish.final_ui_state + screenshotMd + \"\\\\n\\\\n_Verified automatically by Auto-Repro (TinyFish agent). Environment destroyed after test._\";\n} else {\n  markdown = \"### ❌ Agent Could Not Reproduce\\\\n**Version tested:** `\" + version + \"`\\\\nFollowing reported steps, expected behavior occurred: \" + tinyfish.final_ui_state + \".\" + screenshotMd;\n}\n\nreturn [{\n  json: {\n    ...extractData,\n    run_id,\n    verdict,\n    markdown,\n    observations: tinyfish\n  }\n}];"
      },
      "id": "node-build-verdict",
      "name": "Verdict & Markdown",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
